  publisher = {American Physical Society},
  title     = {{Electronic structure of rhombohedral CrX3 (X=Br, Cl, I) van der Waals crystals ELECTRONIC STRUCTURE of RHOMBOHEDRAL ... CRACO, CARARA, SHAO, CHUANG, and FREELON}},
  volume    = {103},
