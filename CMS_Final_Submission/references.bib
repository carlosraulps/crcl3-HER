  issn          = {10797114},
  journal       = {Physical Review Letters},
  keywords      = {doi:10.1103/PhysRevLett.127.037204 url:https://doi},
  number        = {3},
  pages         = {37204},
  pmid          = {34328783},
  publisher     = {American Physical Society},
  title         = {{Monolayer as an Ideal Test Bed for the Universality Classes of 2D Magnetism}},
