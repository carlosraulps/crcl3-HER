# ==============================================================================
# .gitignore for VASP DFT Calculations & HPC Research Workflow
# ==============================================================================
# Tracks essential inputs:
#   - INCAR, POSCAR, KPOINTS, POTCAR, job.sh, scripts (*.py, *.sh)
# Tracks essential outputs:
#   - CONTCAR, OSZICAR, OUTCAR, IBZKPT, *.out
# Tracks reports & metadata:
#   - *.md, *.csv, *.json, *.pdf, *.png
# Ignores heavy wavefunctions, charge densities, volumetric grids, build/dist,
# temporary files, core dumps, and compressed archives.
# ==============================================================================

# --- Heavy VASP Wavefunctions & Volumetric Charge Grids ---
WAVECAR*
CHGCAR*
CHG*
LOCPOT*
ELFCAR*
PARCHG*
TMPCAR*

# --- Heavy Band Structure, DOS, Trajectory & XML Outputs ---
DOSCAR*
EIGENVAL*
PROCAR*
PROOUT*
XDATCAR*
PCDAT
REPORT
vasprun*.xml

# --- Python Build, Packaging & Binary Artifacts ---
build/
dist/
bin/
*.pkg
*.pyz
*.toc
*.spec
*.egg-info/
*.egg
*.so
*.o
*.a
*.exe

# --- Compressed Archives & Large Bundles ---
*.zip
*.tar.gz
*.tar.bz2
*.tar
*.tgz
*.7z
*.rar

# --- Temporary, Scratch, Backup & Crash Files ---
*.bak
*.bak_*
*.tmp
*.temp
scratch/
*/scratch/
core
core.*
STOPCAR

# --- Watchdog, Snapshots & Daemons ---
*.ckpt
*.pid
watchdog.log
*.log

# --- Slurm Error Files ---
*.err

# --- Python & Environment Artifacts ---
__pycache__/
*.py[cod]
*$py.class
.env
.venv
env/
venv/

# --- Operating System & Editor Artifacts ---
.DS_Store
.directory
*~
*.swp
*.swo
.vscode/
.idea/
